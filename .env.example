# Modelo das variáveis de ambiente. Copie este arquivo para ".env" (que o git ignora) e preencha.
# NUNCA coloque valores reais aqui: este arquivo vai para o repositório.

# --- Banco (Aiven > seu serviço PostgreSQL > Connection information) ---
DATABASE_URL=jdbc:postgresql://HOST:PORTA/defaultdb?sslmode=require
DATABASE_USER=
DATABASE_PASSWORD=

# --- Aplicação ---
# Endereço público do painel, usado nos links das fotos. Local: http://localhost:8080
PUBLIC_BASE_URL=http://localhost:8080
# Pasta onde as fotos são gravadas
UPLOAD_DIR=./uploads
# true em produção (HTTPS), para o cookie de login só trafegar por HTTPS
SESSION_COOKIE_SECURE=false
# Prefixo do painel. Vazio localmente; /admin em produção (quimia.tech/admin)
APP_CONTEXT_PATH=

# --- Fotos ---
# disk = pasta do servidor (padrão, bom no computador de quem desenvolve)
# r2   = bucket da Cloudflare R2 (use em hospedagem que apaga o disco a cada reinício, como o Render)
STORAGE_TYPE=disk
# Só se STORAGE_TYPE=r2 (crie o bucket e um token só com Object Read & Write nele, na Cloudflare):
R2_ENDPOINT=https://ID_DA_CONTA.r2.cloudflarestorage.com
# "auto" no R2. Em outro servico compativel com S3 (Backblaze B2), a regiao real, ex.: us-west-004
R2_REGION=auto
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Endereço público do bucket (domínio personalizado), sem barra no final. Ex.: https://fotos.quimia.tech
R2_PUBLIC_BASE_URL=

# --- Proxy ---
# Segredo combinado com o Worker da Cloudflare (a mesma sequência aleatória nos dois lados). Com ele definido, o app
# só aceita pedidos que tragam o cabeçalho X-Origin-Secret igual. Deixe vazio no computador de quem desenvolve.
ORIGIN_SECRET=
